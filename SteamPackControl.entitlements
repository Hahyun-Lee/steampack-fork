<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN"
    "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Widget extensions must be sandboxed. Shared state stays in this
         extension's own container and contains no sensitive information. -->
    <key>com.apple.security.app-sandbox</key>
    <true/>
</dict>
</plist>
